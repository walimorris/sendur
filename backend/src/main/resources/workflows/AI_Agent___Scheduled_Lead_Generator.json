    {
      "parameters": {
        "jsCode": "const names = $input.all().map(i => i.json.businessName);\nconst combined = names.join(\", \");\n\nreturn [\n  {\n    json: {\n      blockedBusinesses: combined\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        -200
      ],
      "id": "02ac2b26-61cf-4a4b-950d-bc5d03cee15e",
      "name": "Blocked Leads"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output\nconst parsed = JSON.parse(raw);\nreturn [{json:{leads: parsed }}];"
