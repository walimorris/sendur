    {
      "parameters": {
        "jsCode": "const leadsWithEmails = [];\n\nfor (const item of $input.all()) {\n  const batch = JSON.parse(item.json.output).allBusinesses;\n\n  for (const lead of batch) {\n    if (\n      lead.email &&\n      lead.email !== 'Not available' &&\n      lead.email.includes('@')\n    ) {\n      leadsWithEmails.push(lead);\n    }\n  }\n}\n\nreturn [\n  {\n    json: {\n      allBusinesses: leadsWithEmails\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        140
      ],
      "id": "a2da87d5-8d85-44b6-9460-1be26a10b9b9",
